{
  "name": "markserv-marker",
  "version": "0.1.2",
  "description": "Single-daemon Markdown preview server with selection-anchored review comments — a markserv fork",
  "license": "MIT",
  "author": "0xys",
  "repository": "github:0xys/markserv-marker",
  "homepage": "https://github.com/0xys/markserv-marker#readme",
  "bugs": "https://github.com/0xys/markserv-marker/issues",
  "preferGlobal": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "markserv-marker": "lib/cli.js"
  },
  "main": "lib/server.js",
  "scripts": {
    "test": "ava",
    "lint": "xo"
  },
  "keywords": [
    "markdown",
    "markserv",
    "preview",
    "review",
    "comments",
    "live-reload",
    "daemon"
  ],
  "files": [
    "lib"
  ],
  "ava": {
    "files": [
      "tests/*.test.js"
    ]
  },
  "xo": {
    "semicolon": false,
    "space": false,
    "ignores": [
      "lib/templates/**"
    ],
    "rules": {
      "unicorn/prefer-module": "off",
      "unicorn/prevent-abbreviations": "off",
      "unicorn/prefer-array-find": "off",
      "comma-dangle": [
        "error",
        "never"
      ],
      "operator-linebreak": "off",
      "import/extensions": "off",
      "import/order": "off",
      "max-params": "off",
      "promise/prefer-await-to-then": "off",
      "no-await-in-loop": "off",
      "unicorn/prefer-event-target": "off",
      "unicorn/no-process-exit": "off",
      "n/prefer-global/process": "off",
      "unicorn/prefer-top-level-await": "off"
    }
  },
  "dependencies": {
    "chalk": "^3.0.0",
    "connect": "^3.7.0",
    "emoji-regex": "^8.0.0",
    "get-port": "^5.1.0",
    "handlebars": "^4.5.3",
    "markdown-it": "^10.0.0",
    "markdown-it-anchor": "^5.2.5",
    "markdown-it-emoji": "^1.4.0",
    "markdown-it-highlightjs": "^3.0.0",
    "markdown-it-mathjax": "^2.0.0",
    "markdown-it-table-of-contents": "^0.4.4",
    "markdown-it-task-lists": "^2.1.1",
    "meow": "^6.0.0",
    "open": "^6.0.0",
    "send": "^0.17.1",
    "ws": "^7.4.0"
  },
  "devDependencies": {
    "ava": "^6.1.3",
    "jsdom": "^29.1.1",
    "xo": "^0.58.0"
  }
}
